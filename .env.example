# ==============================================================================
# FaceCheck V1 — Environment Configuration Template (.env.example)
# Copy to .env and configure with authorized credentials
# ==============================================================================

# Database Connection (PostgreSQL 15+ @ Bank Core Network)
FACECHECK_DB_ENGINE=postgresql
FACECHECK_DB_HOST=127.0.0.1
FACECHECK_DB_PORT=5432
FACECHECK_DB_NAME=facecheck_db
FACECHECK_DB_USER=facecheck_app
FACECHECK_DB_PASSWORD=your_secure_password_here
FACECHECK_DB_CONNECT_TIMEOUT=5

# REST Server & Security
FACECHECK_SERVER_HOST=127.0.0.1
FACECHECK_SERVER_PORT=8000
FACECHECK_API_KEY=your_authorized_api_key_here

# MLOps Worker & Automated Training
FACECHECK_TRAINING_ENABLED=false
FACECHECK_KILL_SWITCH_ENGAGED=false
FACECHECK_TRAINING_INTERVAL_SEC=3600
FACECHECK_AUTO_TRAIN_MIN_NEW_SAMPLES=100

# LLM Reviewer & Explainer (Local-Only by Default)
# Security Policy: Cloud LLMs are disabled by default. Local offline model (Ollama) only.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.0
CLOUD_LLM_ENABLED=false
DATA_RESIDENCY_APPROVED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
