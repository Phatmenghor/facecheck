# ==============================================================================
# FaceCheck Banking KYC Biometrics - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Run scripts/setup.sh to generate random secrets.
# ==============================================================================

ENV=development

# Database Superuser & Connection
POSTGRES_DB=facecheck_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_32_BYTES

# Least-Privilege Database Role Passwords
DB_MIGRATOR_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_32_BYTES
DB_APP_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_32_BYTES
DB_ML_WORKER_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_32_BYTES
DB_READONLY_PASSWORD=CHANGE_ME_GENERATE_RANDOM_SECRET_32_BYTES

# Application Security Keys
FACECHECK_API_KEY=fc-live-CHANGE_ME_GENERATE_RANDOM_HEX_KEY
ENCRYPTION_MASTER_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX_KEY_AES256GCM
AUDIT_HMAC_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX_KEY_HMAC_SHA256

# Server Host & Ports (Always bind to 127.0.0.1 on host)
FACECHECK_SERVER_HOST=0.0.0.0
FACECHECK_SERVER_PORT=8000

# LLM & Offline Policy
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://ollama:11434/v1
CLOUD_LLM_ENABLED=false
DATA_RESIDENCY_APPROVED=false
