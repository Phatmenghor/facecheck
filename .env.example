# ==============================================================================
# FaceCheck V1 — Environment Configuration Template (.env.example)
# Copy to .env and configure with authorized credentials
# ==============================================================================

# Database Connection (PostgreSQL or SQLite)
FACECHECK_DB_ENGINE=postgresql
FACECHECK_DB_HOST=127.0.0.1
FACECHECK_DB_PORT=5432
FACECHECK_DB_NAME=llm_face
FACECHECK_DB_USER=postgres
FACECHECK_DB_PASSWORD=your_secure_password_here
FACECHECK_DB_CONNECT_TIMEOUT=5
FACECHECK_DB_SQLITE_FALLBACK=storage/learning_store.db

# REST Server & Host
FACECHECK_SERVER_HOST=0.0.0.0
FACECHECK_SERVER_PORT=8000
FACECHECK_API_KEY=your_authorized_api_key_here

# Continuous Learning & Background Daemon
FACECHECK_DAEMON_ENABLED=true
FACECHECK_DAEMON_INTERVAL_SEC=60
FACECHECK_AUTO_TRAIN_MIN_NEW_SAMPLES=5

# Online AI Model, Auto-Review & Continuous Online Training (Gemini / OpenAI / Custom LLM Endpoint)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_AUTO_REVIEW_ENABLED=true
LLM_AUTO_FEEDBACK_ENABLED=true
LLM_OPENAI_FINE_TUNING_ENABLED=true
LLM_ONLINE_TRAINING_URL=
