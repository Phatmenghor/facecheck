{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FaceCheck: Run Master Pipeline (run_all.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "FaceCheck: Start API Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "FaceCheck: Run End-to-End Verification Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/full_test_images.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "FaceCheck: Train Face Classifier",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_classifier.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "FaceCheck: Verify Model Checksums",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/verify_checksums.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "FaceCheck: Verify Audit Log Integrity",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/verify_audit_log.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "FaceCheck: Run Pytest Test Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "tests"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
